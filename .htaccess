Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /

# Redirect root to /de/
RewriteRule ^$ /de/ [R=302,L]

# Redirect pages without language folder to /de/
RewriteCond %{REQUEST_URI} !^/(de|en|fr|images|css|js|favicon\.png|.*\.pdf|.*\.docx)/
RewriteCond %{REQUEST_URI} !^/(de|en|fr)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ /de/$1 [R=302,L]

# Force redirect if someone directly requests index.html
RewriteCond %{REQUEST_URI} ^/(.*/)?index\.html$ [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# Redirect any URL ending with .html to clean URL
RewriteCond %{REQUEST_URI} ^(.+)\.html$ [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Internally add .html if file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

DirectoryIndex index.html
